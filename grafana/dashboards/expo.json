{
  "title": "Expo Calculator",
  "uid": "expo-calculator",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Website up? (1 = yes, 0 = no)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "up{job=\"expo-website\"}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Calculations so far",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "refId": "A", "expr": "sum(expo_calculations_total)" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Average time (seconds)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "expo_calculation_seconds_sum / expo_calculation_seconds_count"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Calculations per second (ok vs error)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 6 },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(expo_calculations_total[1m])",
          "legendFormat": "{{result}}"
        }
      ]
    }
  ]
}
